---
import { site } from '../data/site';
---

<!-- Decorative animated cursor. It never follows the real mouse; src/scripts/motion.ts moves it. -->
<div class="ghost-cursor" aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none">
    <path
      d="M3 2.5 L20 11.2 L12.4 13.1 L8.9 20.6 Z"
      fill="#16201a"
      stroke="#fff"
      stroke-width="1.6"
      stroke-linejoin="round"></path>
  </svg>
  <span class="ghost-tag">{site.name}</span>
</div>
